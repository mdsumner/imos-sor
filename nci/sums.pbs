#!/bin/bash
#PBS -q normal
#PBS -l ncpus=16
#PBS -l mem=64GB
#PBS -l walltime=08:00:00
#PBS -l jobfs=1GB
#PBS -l wd
#PBS -j oe
#PBS -N imos-sor-sums
## The IMOS L3S SST record (BoM/IMOS ABOM GHRSST L3S 1-day, not MUR) as
## exact daily sums, in situ from sh74: S2 L5 cells (trend.sst schema), the
## region sets and the whole domain, for the all / q4 / q4b variants
## (nci/sums.R; R/07 for whole records), after the ice-flag and -2.5..40 C
## screen. Products (PRODUCTS, default all):
##   multi         day+night SSTfnd, Continental + Southern, 2012-01 ->   5,333 days
##   single        day+night SSTfnd, Continental + Southern, 1992-03 ->  12,077 days
##   single_night  night SSTskin, Continental only (STAR 1.2), 1992-03 -> 12,068 days
## Day+night: ~10 s per day per worker on Gadi (job 184447215: 3 h 56 min with
## NWORK=12, 126 SU). Night reads one window, so expect about 6 s a day:
## ~1.7 h and ~55 SU for single_night alone.
## Resumable (finished product-months are skipped), so rerun the same command
## if it hits walltime.
##
##   qsub -P jk72 -l storage=gdata/sh74+gdata/jk72 sums.pbs
##   qsub -P jk72 -l storage=gdata/sh74+gdata/jk72 -v PRODUCTS=single_night sums.pbs   (one product)
##   qsub -P jk72 -l storage=gdata/sh74+gdata/jk72 -v PRODUCTS=multi,YEARS=2024 sums.pbs   (a subset)
##
## Needs in $OUTDIR: inventory-sh74_IMOS_AODN_IMOS_SRS_SST_ghrsst.tsv.gz
## (inventory.pbs) and offset_kit.rds (nci/offset_kit.R, already copied for
## the offset job). Output: $OUTDIR/sums-v2/<product>/<YYYY-MM>.rds,
## domain_km2.rds and screen.rds. (The first run, made before the screen,
## was in $OUTDIR/sums; deleted 2026-11-18. sums.R refuses to add to such a
## directory.)
## Memory: ~3.5 GB per worker, so NWORK=12 for 64 GB.
set -euo pipefail
module load singularity
SIF=${SIF:-/g/data/jk72/$USER/sif_lib/gdal-r-python-extras_latest.sif}
[ -f "$SIF" ] || { echo "no image at $SIF" >&2; exit 1; }
OUTDIR=${OUTDIR:-/g/data/jk72/$USER/imos-sor-probe}
INV=inventory-sh74_IMOS_AODN_IMOS_SRS_SST_ghrsst.tsv.gz
for f in $INV offset_kit.rds; do
  [ -f "$OUTDIR/$f" ] || { echo "missing $OUTDIR/$f" >&2; exit 1; }
done
SUMS=$OUTDIR/sums-v2
mkdir -p "$SUMS"
## keep host R/Python libraries out of the container (as in raad.virtualize); pass the job settings in
export SINGULARITYENV_R_LIBS_USER=/nonexistent SINGULARITYENV_R_LIBS= SINGULARITYENV_PYTHONNOUSERSITE=1
export SINGULARITYENV_NWORK=${NWORK:-12}
for v in PRODUCTS YEARS MONTHS MAXDAYS; do
  [ -n "${!v:-}" ] && export "SINGULARITYENV_$v=${!v}"
done
echo "start $(date -Is) NWORK=$SINGULARITYENV_NWORK PRODUCTS=${PRODUCTS:-all} YEARS=${YEARS:-all} MONTHS=${MONTHS:-all}"
singularity exec -B /g/data "$SIF" Rscript "$PBS_O_WORKDIR/sums.R" \
  "$OUTDIR/$INV" "$OUTDIR/offset_kit.rds" "$SUMS" /g/data/sh74/IMOS_AODN \
  "$PBS_O_WORKDIR/compare-IMOS_SRS_SST_ghrsst-files.csv"
echo "done $(date -Is): $(find "$SUMS" -mindepth 2 -name '*.rds' | wc -l) product-month files in $SUMS"
